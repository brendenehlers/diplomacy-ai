# Copy to .env and fill in. `just` auto-loads .env (set dotenv-load).
# .env is gitignored; .env.example is committed.

# --- Local LM Studio (default model) ---
LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# --- Hosted providers (only needed if you switch models in game.toml) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Tests ---
# Set to 1 to enable the opt-in live smoke test.
# RUN_SMOKE=0
