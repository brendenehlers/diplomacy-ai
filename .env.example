# Copy to .env and fill in. `just` auto-loads .env (set dotenv-load).
# .env is gitignored; .env.example is committed.

# --- ngrok AI Gateway (the only credential needed) ---
NGROK_API_KEY=

# Override only if you use a custom gateway endpoint.
# NGROK_BASE_URL=https://gateway.ngrok.ai/v1

# --- Tests ---
# Set to 1 to enable the opt-in live smoke test.
# RUN_SMOKE=0
